{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Authority": "https://localhost:5010",
    "Audience": "banking-gateway",
    "RequireHttpsMetadata": true
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "",
    "InstanceName": "BankingGateway_"
  },
  "RateLimit": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "Resilience": {
    "RetryCount": 3,
    "RetryBaseDelayMs": 200,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerDurationSeconds": 30,
    "TimeoutSeconds": 30
  },
  "SecurityHeaders": {
    "EnableHsts": true,
    "HstsMaxAgeSeconds": 31536000,
    "MaxRequestBodySize": 10485760,
    "EnableIpFiltering": false,
    "AllowedIpRanges": []
  },
  "ReverseProxy": {
    "Routes": {
      "accounts-route": {
        "ClusterId": "accounts-cluster",
        "Match": {
          "Path": "/api/accounts/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeader": "X-Correlation-ID", "Set": "{Header:X-Correlation-ID}" }
        ]
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeader": "X-Correlation-ID", "Set": "{Header:X-Correlation-ID}" }
        ]
      }
    },
    "Clusters": {
      "accounts-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "accounts-primary": {
            "Address": "https://accounts-service.internal:5001/"
          },
          "accounts-secondary": {
            "Address": "https://accounts-service.internal:5002/"
          }
        }
      },
      "payments-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "payments-primary": {
            "Address": "https://payments-service.internal:5003/"
          }
        }
      }
    }
  }
}
