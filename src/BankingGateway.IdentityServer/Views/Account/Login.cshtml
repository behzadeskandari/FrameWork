@using BankingGateway.IdentityServer.Controllers
@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    var returnUrl = ViewData["ReturnUrl"] as string ?? string.Empty;
}

<div class="card" style="max-width: 420px; margin: 3rem auto;">
    <h2 style="margin-bottom: 1.5rem; color: #1a3a5c;">Sign In</h2>

    <div asp-validation-summary="All" class="text-danger"></div>

    <form method="post" asp-action="Login" asp-controller="Account" asp-route-returnUrl="@returnUrl">
        @Html.AntiForgeryToken()

        <div class="form-group mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" type="email" class="form-control" autocomplete="username" autofocus />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group form-check mb-3">
            <input asp-for="RememberMe" type="checkbox" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-primary w-100">Sign In</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}