@model BankingGateway.IdentityServer.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="card" style="max-width:420px; margin:3rem auto;">
    <h2 style="margin-bottom:1.5rem; color:#1a3a5c;">Sign In</h2>

    <div asp-validation-summary="All" class="validation-summary-errors"></div>

    <form method="post" asp-action="Login" asp-controller="Account" asp-route-returnUrl="@returnUrl">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label asp-for="Email">Email Address</label>
            <input asp-for="Email" type="email" autocomplete="username" autofocus />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>

        <div class="form-group" style="display:flex;align-items:center;gap:0.5rem;">
            <input asp-for="RememberMe" type="checkbox" id="RememberMe" style="width:auto;" />
            <label asp-for="RememberMe" style="margin-bottom:0;">Remember me</label>
        </div>

        <button type="submit" class="btn btn-primary" style="width:100%; margin-top:0.5rem;">Sign In</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
