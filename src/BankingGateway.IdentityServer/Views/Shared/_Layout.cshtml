<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Banking Identity Server</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', sans-serif; background: #f4f6f9; color: #333; }
        header { background: #1a3a5c; color: #fff; padding: 1rem 2rem; display: flex; align-items: center; gap: 1rem; }
        header h1 { font-size: 1.25rem; font-weight: 600; }
        main { max-width: 900px; margin: 2rem auto; padding: 0 1rem; }
        footer { text-align: center; padding: 1rem; color: #888; font-size: 0.85rem; margin-top: 2rem; }
        .card { background: #fff; border-radius: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); padding: 2rem; }
        .btn { display: inline-block; padding: 0.6rem 1.4rem; border-radius: 4px; border: none; cursor: pointer; font-size: 1rem; }
        .btn-primary { background: #1a3a5c; color: #fff; }
        .btn-primary:hover { background: #15304d; }
        .form-group { margin-bottom: 1rem; }
        .form-group label { display: block; margin-bottom: 0.3rem; font-weight: 500; }
        .form-group input { width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #ccc; border-radius: 4px; font-size: 1rem; }
        .validation-summary-errors ul { color: #c0392b; list-style: none; margin-bottom: 1rem; }
        .field-validation-error { color: #c0392b; font-size: 0.875rem; }
    </style>
</head>
<body>
    <header>
        <h1>🏦 Banking Gateway — Identity Server</h1>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer>
        &copy; @DateTime.UtcNow.Year Banking Gateway. All rights reserved.
    </footer>
</body>
</html>
