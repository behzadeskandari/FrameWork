{
  "Gateway": {
    "Name": "Banking Gateway",
    "Version": "1.0.0",
    "Environment": "Development",
    "Security": {
      "EnableHttpsRedirection": false,
      "EnableHsts": false,
      "Jwt": {
        "Authority": "",
        "Audience": "banking-gateway",
        "Issuer": "banking-gateway-issuer",
        "SecretKey": "CHANGE_THIS_TO_A_SECURE_KEY_WITH_AT_LEAST_32_CHARACTERS_LONG!!",
        "AccessTokenExpirationMinutes": 15,
        "RefreshTokenExpirationDays": 7,
        "RequireHttpsMetadata": false,
        "ValidateIssuer": true,
        "ValidateAudience": true,
        "ValidateLifetime": true
      },
      "RateLimit": {
        "Enabled": true,
        "PermitLimit": 100,
        "WindowSeconds": 60,
        "QueueLimit": 10
      },
      "AllowedIps": [],
      "MaxRequestBodySize": 10485760,
      "AllowedOrigins": []
    },
    "Logging": {},
    "Cache": {
      "UseDistributedCache": false,
      "RedisConnectionString": "",
      "InstanceName": "BankingGateway_",
      "DefaultExpirationMinutes": 30
    },
    "Resilience": {
      "RetryCount": 3,
      "RetryBaseDelayMs": 200,
      "CircuitBreakerThreshold": 5,
      "CircuitBreakerDurationSeconds": 30,
      "TimeoutSeconds": 30
    }
  },
  "ReverseProxy": {
    "Routes": {
      "account-route": {
        "ClusterId": "account-cluster",
        "Match": {
          "Path": "/api/accounts/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/accounts" }
        ]
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/payments" }
        ]
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/notifications" }
        ]
      }
    },
    "Clusters": {
      "account-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5101/"
          }
        },
        "LoadBalancingPolicy": "RoundRobin"
      },
      "payment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5102/"
          }
        },
        "LoadBalancingPolicy": "RoundRobin"
      },
      "notification-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5103/"
          }
        },
        "LoadBalancingPolicy": "RoundRobin"
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "SeqUrl": ""
  },
  "AllowedHosts": "*"
}
